APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Tiempo real (Soketi, compatible con Pusher) ──────────────────────────────
# Con BROADCAST_DRIVER=log (default arriba) el tiempo real esta APAGADO y la app
# funciona igual que siempre. Para encenderlo: BROADCAST_DRIVER=pusher y llena esto.
# Los App ID/KEY/SECRET los defines tu (deben coincidir con la config de Soketi).
# Local:  PUSHER_HOST=127.0.0.1  PUSHER_PORT=6001  PUSHER_SCHEME=http
# Prod:   PUSHER_HOST=sender.prestamaz.site  PUSHER_PORT=443  PUSHER_SCHEME=https  (Nginx hace wss)
PUSHER_APP_ID=wacloud
PUSHER_APP_KEY=wacloudkey
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SMS Gateway (SMS Gateway for Android — self-host)
# Self-host lleva /api en la ruta: http://127.0.0.1:3000/api/3rdparty/v1
# Credenciales (LOGIN/PASSWORD) se autogeneran al conectar el teléfono al server.
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TIMEOUT=15
SMS_WEBHOOK_SECRET=
